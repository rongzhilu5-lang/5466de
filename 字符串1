#include <stdio.h>
#include <string.h>

char* mycpy(char* dest, const char* src) {
    int idx = 0;
    while (src[idx] != '\0') {
        dest[idx] = src[idx];
        idx++;
    }
    dest[idx] = '\0';

    return dest;
} 

int main(int argc, char const *argv[]){

    char s1[] = "abc";
    char s2[] = "abc";
    mycpy(s2, s1);

    return 0;
}
